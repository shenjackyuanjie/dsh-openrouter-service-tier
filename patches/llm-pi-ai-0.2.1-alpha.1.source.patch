+    profiles = resolveProfiles({ openrouter: { baseURL: server.url, headers: { 'X-Test': 'unchanged' }, serviceTier: 'priority' } })
+    await drain(prepared.stream(options))
+    await drain(adapter.stream(options))
+    profiles = resolveProfiles({ openrouter: { baseURL: server.url, serviceTier: 'flex', modelServiceTiers: [{ model: chat.id, tier: 'omit' }] } })
