diff --git a/packages/llm/llm-pi-ai/src/service-tier.ts b/packages/llm/llm-pi-ai/src/service-tier.ts
new file mode 100644
--- /dev/null
+++ b/packages/llm/llm-pi-ai/src/service-tier.ts
@@ -0,0 +1,36 @@
+/** OpenRouter request-tier selection; descriptors and authentication stay unchanged. */
+import type { PiAiProviderProfile } from './config.ts'
+
+/** Wire values accepted by OpenRouter Chat Completions, Responses, and Messages. */
+export const OPENROUTER_SERVICE_TIERS = ['default', 'flex', 'priority', 'fast', 'ultrafast'] as const
+
+/** One OpenRouter wire tier; `omit` and null are configuration-only choices. */
+export type OpenRouterServiceTier = typeof OPENROUTER_SERVICE_TIERS[number]
+
+/** Exact model-id override; omission suppresses the global tier. */
+export interface OpenRouterModelServiceTier {
+  /** Model id in the route's resolved catalog. */
+  model: string
+  /** Wire tier, or explicit suppression of the global value. */
+  tier: OpenRouterServiceTier | 'omit'
+}
+
+/**
+ * Select a tier from one captured profile, never from live settings.
+ * @param profile - the request's resolved profile.
+ * @param model - exact model id.
+ * @returns the wire tier, or undefined when no tier should be sent.
+ */
+export function openRouterTierFor(profile: Pick<PiAiProviderProfile, 'serviceTier' | 'modelServiceTiers'>, model: string): OpenRouterServiceTier | undefined {
+  const tier = profile.modelServiceTiers?.find(entry => entry.model === model)?.tier ?? profile.serviceTier
+  return tier === 'omit' || tier === null ? undefined : tier
+}
+
+/**
+ * Whether an OpenRouter API accepts a top-level service_tier.
+ * @param api - the resolved model protocol.
+ * @returns true for the three documented OpenRouter HTTP APIs.
+ */
+export function supportsOpenRouterTier(api: string): boolean {
+  return ['openai-completions', 'openai-responses', 'anthropic-messages'].includes(api)
+}
